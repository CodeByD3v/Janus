# Janus environment template
#
# Copy this file to .env and replace every `replace-me` value before starting
# the service. Never commit .env or paste real secrets into this file.
#
# Local Compose usage:
#   cp .env.example .env
#   docker compose --profile build build sandbox-builder
#   docker compose up --build
#
# Production deploy-host .env files are managed out of band. GitHub Actions
# deployment credentials (DEPLOY_HOST, DEPLOY_USER, DEPLOY_SSH_KEY, DEPLOY_PATH,
# and registry credentials) belong in repository/environment secrets, not here.

# -----------------------------------------------------------------------------
# Authentication and repository safety
# -----------------------------------------------------------------------------
# Required by the API. Format: key:tenant-id,key:tenant-id
API_KEYS=replace-me-with-a-long-random-tenant-key:tenant-id
# Optional. Format: key:operator-id; empty disables /admin access.
ADMIN_API_KEYS=
# Required for accepting local repo_ref values. Use absolute paths, comma-separated.
ALLOWED_REPO_ROOTS=/absolute/path/to/allowed/repositories
# Empty disables browser CORS. Use explicit origins in deployed environments.
CORS_ALLOWED_ORIGINS=

# -----------------------------------------------------------------------------
# LLM providers and model selection
# -----------------------------------------------------------------------------
# At least one provider credential is required by the worker.
GOOGLE_API_KEY=replace-me-with-google-api-key
# Optional comma-separated Google key pool; takes precedence over GOOGLE_API_KEY.
GOOGLE_API_KEYS=
GOOGLE_API_KEY_COOLDOWN_SECONDS=30
ADV_REVIEW_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
COHERE_API_KEY=
# Optional local Ollama runtime. Set OLLAMA_ENABLED=true only when Ollama is
# running on this machine (normally http://localhost:11434).
OLLAMA_ENABLED=false
OLLAMA_API_BASE=http://localhost:11434
# Required only when accepting encrypted per-request BYOK credentials.
BYOK_ENCRYPTION_KEY=

# -----------------------------------------------------------------------------
# Debate controls
# -----------------------------------------------------------------------------
ADV_REVIEW_MAX_ROUNDS=5
ADV_REVIEW_CIRCUIT_FAILURE_THRESHOLD=5
ADV_REVIEW_CIRCUIT_COOLDOWN_SECONDS=60

# -----------------------------------------------------------------------------
# Database and behavioral retrieval
# -----------------------------------------------------------------------------
# SQLite is convenient for local development. Compose deployments override this
# internally with PostgreSQL on the db service.
DATABASE_URL=sqlite:///./adversarial_code_review.db
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION=real_catch_examples
SEED_DATA_PATH=./data/real_catch_examples.seed.jsonl
EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# Repository-context retrieval
# -----------------------------------------------------------------------------
REPO_CONTEXT_MAX_FILES_SCANNED=200
REPO_CONTEXT_MAX_PRIOR_FIXES=5
REPO_CONTEXT_MAX_TEST_SAMPLES=5
REPO_CONTEXT_SNIPPET_CHARS=400
REPO_CONTEXT_GIT_TIMEOUT=10
REPO_CONTEXT_FIX_KEYWORDS=fix,bug,patch,issue,crash,regression,hotfix
REPO_CONTEXT_TEST_DIR_NAMES=tests,testing,test

# -----------------------------------------------------------------------------
# Deterministic gate and sandbox
# -----------------------------------------------------------------------------
USE_CONTAINERIZED_GATE=false
SANDBOX_IMAGE=adv-review-sandbox:latest
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1
SANDBOX_PID_LIMIT=128
SANDBOX_TIMEOUT=120

# -----------------------------------------------------------------------------
# API and rate limiting
# -----------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# -----------------------------------------------------------------------------
# Worker and lifecycle safety
# -----------------------------------------------------------------------------
WORKER_POLL_INTERVAL=5
WORKER_MAX_CONCURRENT=4
LLM_CALL_TIMEOUT_SECONDS=180
ZOMBIE_SESSION_TIMEOUT_MINUTES=30
ZOMBIE_SWEEP_INTERVAL_SECONDS=300

# -----------------------------------------------------------------------------
# Logging, metrics, and async-stall diagnostics
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
METRICS_ENABLED=true
# Enable only while reproducing the documented MCP/event-loop stall.
DIAGNOSTIC_PERSIST_TRACE=false
DIAGNOSTIC_PERSIST_TRACE_PATH=/tmp/janus_persist_trace.log

# -----------------------------------------------------------------------------
# Notifications and legacy single-tenant GitHub access
# -----------------------------------------------------------------------------
# GITHUB_TOKEN is a legacy fallback only. GitHub App installations use scoped
# short-lived tokens instead; do not use a shared PAT for multi-tenant reviews.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=
GITHUB_WEBHOOK_SECRET_REQUIRED=true
DEFAULT_WEBHOOK_URL=
NOTIFICATION_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# GitHub App installation mode
# -----------------------------------------------------------------------------
GITHUB_APP_ID=
# Provide the PEM through a secret manager. If represented on one line, encode
# newlines as \\n rather than committing the private key itself.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_JWT_TTL_SECONDS=540
GITHUB_TOKEN_CACHE_SKEW_SECONDS=60
GITHUB_REPO_CACHE_DIR=/tmp/janus-github-repos

# -----------------------------------------------------------------------------
# MCP server
# -----------------------------------------------------------------------------
# Leave commented to use the repository default.
# MCP_SERVER_SCRIPT=/absolute/path/to/Janus/mcp_server/server.py

# -----------------------------------------------------------------------------
# Production Compose image selectors (used by docker-compose.prod.yml)
# -----------------------------------------------------------------------------
# These are deployment selectors, not application credentials.
# REGISTRY=ghcr.io
# IMAGE_PREFIX=codebyd3v/janus
# IMAGE_TAG=replace-me-with-git-sha
